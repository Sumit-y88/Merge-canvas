MONGODB_URI=mongodb://localhost:27017/mergeCanvas
PORT=5000
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
NODE_ENV=development
REDIS_URL=redis://localhost:6379
# Required when running more than one API instance so Socket.IO room events are shared.
MAX_BODY_SIZE=8mb
MAX_CANVAS_BYTES=8388608
MAX_CANVAS_ELEMENTS=5000
MAX_IMAGE_BYTES=2097152
MAX_FREEHAND_POINTS=10000
YJS_ROOM_CACHE_TTL_MS=1800000
MAX_CACHED_YJS_ROOMS=1000
