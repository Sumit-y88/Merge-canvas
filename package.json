{
  "name": "mergecanvas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node ops/run-services.mjs dev",
    "start": "node ops/run-services.mjs start",
    "postinstall": "npm install --prefix client",
