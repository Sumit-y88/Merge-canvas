# ==============================================================================
# MergeCanvas — Unified Environment Variables (for Vercel & Local)
# ==============================================================================

# Database (MongoDB Atlas recommended for Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mergecanvas?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=generate-a-strong-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Google OAuth (Optional — for "Sign in with Google")
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Pusher Realtime Collaboration (for live cursors, drafts, & CRDT sync on Vercel)
# Sign up free at https://pusher.com/channels
NEXT_PUBLIC_PUSHER_KEY=your-pusher-app-key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
PUSHER_APP_ID=your-pusher-app-id
PUSHER_SECRET=your-pusher-secret-key

# Optional (Defaults to /api for same-domain hosting on Vercel)
# NEXT_PUBLIC_API_URL=/api
